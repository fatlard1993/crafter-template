{
	"schemaVersion": 1,
	"id": "crafter-template",
	"version": "${version}",
	"name": "Crafter Template",
	"description": "Makes the Crafter block retain 1 item in each slot, preserving your recipe pattern as a template.",
	"authors": [
		"justfatlard"
	],
	"contact": {
		"homepage": "https://github.com/fatlard1993/crafter-template",
		"sources": "https://github.com/fatlard1993/crafter-template",
		"issues": "https://github.com/fatlard1993/crafter-template/issues"
	},
	"license": "MIT",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.crafter_template.Main"
		]
	},
	"mixins": [
		"crafter-template.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25"
	},
	"suggests": {
		"block-tip": ">=1.0.0"
	},
	"breaks": {
		"block-tip": "<1.0.0"
	}
}
